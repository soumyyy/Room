# Generate a random secret of at least 24 characters. Use HTTPS for the public endpoint.
ROOM_SCHEDULER_TOKEN=
ROOM_SCHEDULER_DB=/data/schedules.sqlite
HOST=0.0.0.0
PORT=8080
ROOM_TUYA_CLIENT_ID=
ROOM_TUYA_CLIENT_SECRET=
ROOM_TUYA_API_BASE_URL=
ROOM_TUYA_INFRARED_ID=
ROOM_TUYA_AC_REMOTE_ID=
ROOM_TUYA_NODE_ID=
# Optional for execution, required for closed-app failure alerts.
ROOM_APNS_KEY_FILE=/run/secrets/apns.p8
ROOM_APNS_KEY_ID=
ROOM_APNS_TEAM_ID=
ROOM_APNS_TOPIC=org.name.homecontrol
