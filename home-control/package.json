{
  "name": "home-control",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "postinstall": "node ./scripts/gen-secrets.mjs",
    "secrets": "node ./scripts/gen-secrets.mjs",
    "start": "node ./node_modules/expo/bin/cli start",
    "android": "node ./node_modules/expo/bin/cli run:android",
    "ios": "node ./node_modules/expo/bin/cli run:ios",
    "web": "node ./node_modules/expo/bin/cli start --web",
    "test": "./scripts/run-tests.sh",
    "typecheck": "tsc --noEmit",
    "check:native": "node scripts/check-native.mjs"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "crypto-js": "^4.2.0",
    "expo": "^55.0.0",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.30",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-udp": "^4.1.7"
  },
  "private": true,
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/react": "~19.2.10",
    "@types/react-native": "^0.72.8",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "@expo/metro-config": "54.0.14"
  }
}
